module(
    name = "yidiandb",
    version = "0.0.1",
    compatibility_level = 1,
)

bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "bazel_skylib", version = "1.7.1")

archive_override(
    module_name = "bazel_features",
    integrity = "sha256-LwV90CCYoQYJXqKRtDRCVzmKBZ6tssdMxHDeD5Zk3M0=",
    strip_prefix = "bazel_features-1.28.0",
    urls = [
        "https://github.com/bazel-contrib/bazel_features/releases/download/v1.28.0/bazel_features-v1.28.0.tar.gz",
        "https://ghproxy.net/https://github.com/bazel-contrib/bazel_features/releases/download/v1.28.0/bazel_features-v1.28.0.tar.gz",
    ],
    patches = ["//third_party:bazel_features_module_dot_bazel_version.patch"],
    patch_strip = 1,
)

bazel_dep(name = "rules_proto", version = "5.3.0-21.7", repo_name = "rules_proto")
bazel_dep(name = "apple_support", version = "1.17.1")

bazel_dep(name = "protobuf", version = "27.3", repo_name = "com_google_protobuf")
bazel_dep(name = "abseil-cpp", version = "20230802.0", repo_name = "com_google_absl")
bazel_dep(name = "gflags", version = "2.2.2", repo_name = "com_github_gflags_gflags")
bazel_dep(name = "glog", version = "0.7.1", repo_name = "com_github_google_glog")
bazel_dep(name = "zlib", version = "1.3.1.bcr.5", repo_name = "com_github_madler_zlib")
bazel_dep(name = "libunwind", version = "1.8.1", repo_name = "com_github_libunwind_libunwind")

bazel_dep(name = "leveldb", version = "1.23", repo_name = "com_github_google_leveldb")
single_version_override(
    module_name = "leveldb",
    version = "1.23",
    registry = "https://raw.githubusercontent.com/secretflow/bazel-registry/main",
)

bazel_dep(name = "yikv", version = "0.0.1")
local_path_override(
    module_name = "yikv",
    path = "../yikv",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

new_local_repository(
    name = "openssl",
    path = "third_party/openssl_stub",
    build_file_content = """\
load("@rules_cc//cc:defs.bzl", "cc_library")
package(default_visibility = ["//visibility:public"])
cc_library(name = "ssl", linkopts = ["-lssl"])
cc_library(name = "crypto", linkopts = ["-lcrypto"])
""",
)

new_local_repository(
    name = "librdkafka",
    path = "third_party/librdkafka_stub",
    build_file_content = """\
load("@rules_cc//cc:defs.bzl", "cc_library")
package(default_visibility = ["//visibility:public"])
cc_library(
    name = "rdkafka",
    hdrs = glob(["include/librdkafka/*.h"]),
    includes = ["include"],
    linkopts = ["-lrdkafka"],
)
""",
)

new_local_repository(
    name = "nlohmann_json",
    path = "third_party/nlohmann_json_stub",
    build_file_content = """\
load("@rules_cc//cc:defs.bzl", "cc_library")
package(default_visibility = ["//visibility:public"])
cc_library(
    name = "json",
    hdrs = glob(["include/nlohmann/*.hpp"]),
    includes = ["include"],
)
""",
)

http_archive(
    name = "com_github_apache_brpc",
    sha256 = "60f218554527f05ad8fae3cb8f81879d0c7dc72b249cde132049c44b1a73e76d",
    strip_prefix = "brpc-1.16.0",
    urls = [
        "https://github.com/apache/brpc/archive/refs/tags/1.16.0.tar.gz",
        "https://ghproxy.net/https://github.com/apache/brpc/archive/refs/tags/1.16.0.tar.gz",
    ],
)
